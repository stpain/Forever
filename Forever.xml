<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <Frame name="ForeverTBDSideTabTemplate" inherits="LargeSideTabButtonTemplate" mixin="ForeverTBDSideTabMixin" virtual="true">
        <Scripts>
            <OnLoad method="OnLoad" inherit="none"/>
        </Scripts>
    </Frame>

    <Frame name="ForeverTBDOptionsListTemplate" virtual="true">
        <Size x="280" y="26"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="HoverBackground" inherits="HoverBackgroundTemplate">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">

            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="LEFT" x="37" y="0"/>
                        <Anchor point="RIGHT" relativePoint="CENTER" x="-55" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
			<Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" frameStrata="HIGH" scale=".8" frameLevel="100" hidden="true">
				<Size x="1" y="1"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="16" y="-10" relativeKey="$parent.Text" relativePoint="LEFT"/>
				</Anchors>
			</Frame>
        </Frames>
    </Frame>

    <Frame name="ForeverTBDOptionsListCheckboxTemplate" inherits="ForeverTBDOptionsListTemplate" virtual="true">
        <Frames>
            <CheckButton parentKey="CheckBox" inherits="SettingsCheckboxTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativePoint="CENTER" x="0" y="0"/>
                </Anchors>
            </CheckButton>
        </Frames>
    </Frame>


    <Frame name="ForeverTBDUI" inherits="PortraitFrameTemplate" mixin="ForeverTBDMixin" parent="UIParent" movable="true">

        <Size x="1000" y="600"/>

        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>

		<Frames>
            <Button parentKey="HelpTipButton">
                <Anchors>
                    <Anchor point="TOPLEFT" x="54" y="1"/>
                </Anchors>
                <Size x="22" y="22"/>
                <NormalTexture atlas="glueannouncementpopup-icon-info"/>
                <HighlightTexture atlas="gamepad-actionbar-circleslot-casting"/>
                <Layers>
                    <Layer level="BACKGROUND" textureSubLevel="-1">
                        <Texture atlas="UI-HUD-UnitFrame-Target-PortraitOn-Boss-IconRing">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-4" y="4"/>
                                <Anchor point="BOTTOMRIGHT" x="4" y="-4"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>

            <Button parentKey="Options">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-8" y="-27"/>
                </Anchors>
                <Size x="32" y="32"/>
                <NormalTexture atlas="common-button-square-gray-up"/>
                <PushedTexture atlas="common-button-square-gray-down"/>
                <HighlightTexture atlas="WoWShare-Highlight">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="5" y="-5"/>
                        <Anchor point="BOTTOMRIGHT" x="-5" y="5"/>
                    </Anchors>
                </HighlightTexture>
                    <Layers>
                    <Layer level="OVERLAY">
                        <Texture atlas="OptionsIcon-Brown">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                            <Size x="14" y="14"/>
                        </Texture>
                    </Layer>
                    </Layers>
            </Button>

            <Button parentKey="WhatsNewButton" inherits="UIPanelButtonTemplate" text="SPLASH_NEW_HEADER">
                <Anchors>
                    <Anchor point="RIGHT" relativePoint="LEFT" relativeKey="$parent.Options" x="-5"/>
                </Anchors>
                <Size x="120" y="24"/>
                <Scripts>
                    <OnClick>
                        self:GetParent().WhatsNew:Show()
                    </OnClick>
                </Scripts>
            </Button>

			<Frame parentKey="Tab1" inherits="ForeverTBDSideTabTemplate" parentArray="Tabs" id="1">
				<KeyValues>
					<KeyValue key="tooltipText" value="CHARACTER" type="global"/>
					<KeyValue key="iconAtlas" value="gamepad-radial-icon-character" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" y="-60"/>
				</Anchors>
			</Frame>
			<Frame parentKey="Tab2" inherits="ForeverTBDSideTabTemplate" parentArray="Tabs" id="2">
				<KeyValues>
					<KeyValue key="tooltipText" value="TRADESKILLS" type="global"/>
					<KeyValue key="iconAtlas" value="gamepad-radial-icon-professions" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab1" relativePoint="BOTTOMLEFT" y="-2"/>
				</Anchors>
			</Frame>
			<Frame parentKey="Tab3" inherits="ForeverTBDSideTabTemplate" parentArray="Tabs" id="3">
				<KeyValues>
					<KeyValue key="tooltipText" value="CHAT" type="global"/>
					<KeyValue key="iconAtlas" value="gamepad-radial-icon-chat" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab2" relativePoint="BOTTOMLEFT" y="-2"/>
				</Anchors>
			</Frame>
			<Frame parentKey="Tab4" inherits="ForeverTBDSideTabTemplate" parentArray="Tabs" id="4">
				<KeyValues>
					<KeyValue key="tooltipText" value="PROFESSIONS_JOURNAL_TAB_NAME" type="global"/>
					<KeyValue key="iconAtlas" value="gamepad-radial-icon-questlog-up" type="string"/>
					<!-- <KeyValue key="iconAtlas" value="gamepad-radial-icon-quests" type="string"/> -->
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab3" relativePoint="BOTTOMLEFT" y="-2"/>
				</Anchors>
			</Frame>
			<Frame parentKey="Tab5" inherits="ForeverTBDSideTabTemplate" parentArray="Tabs" id="5" hidden="false">
				<KeyValues>
					<KeyValue key="tooltipText" value="Interactions" type="string"/>
					<KeyValue key="iconAtlas" value="gamepad-radial-icon-emotes-up" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab4" relativePoint="BOTTOMLEFT" y="-2"/>
				</Anchors>
			</Frame>

            <Frame parentKey="InsetBorder" inherits="InsetFrameTemplate3" useParentLevel="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
            </Frame>

            <Frame parentKey="OptionsPanel" parentArray="Views" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
                <Frames>
                    <Button parentKey="RESET_EVERYTHING" inherits="UIPanelButtonTemplate" text="RESET">
                        <Anchors>
                            <Anchor point="BOTTOM" x="0" y="20"/>
                        </Anchors>
                        <Size x="200" y="24"/>
                    </Button>
					<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
						<Anchors>
							<Anchor point="TOPLEFT" x="200" y="-62"/>
							<Anchor point="BOTTOMLEFT" x="200" y="55"/>
							<Anchor point="RIGHT" x="-30" y="0"/>
						</Anchors>
                        <Size x="500"/>
					</Frame>

					<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar" frameStrata="HIGH">
						<Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="5" y="-5"/>
                            <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
						</Anchors>
					</EventFrame>
                </Frames>
            </Frame>

            <Frame name="ForeverTBDUIWhatsNewFrame" parentKey="WhatsNew" frameStrata="DIALOG" inherits="PortraitFrameTemplate" hidden="true">
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
                <Size x="640" y="340"/>
                <Frames>
                    <Frame parentKey="Text" inherits="ScrollingFontTemplate">
                        <Size x="560" y="240"/>
                        <Anchors>
                            <Anchor point="BOTTOM" x="0" y="20"/>
                        </Anchors>
                        <KeyValues>
                            <KeyValue key="fontName" value="GameFontWhite"/>
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>

            <Frame parentKey="CharacterSummary" inherits="ForeverTBDCharacterSummary" parentArray="Views" id="1">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
            </Frame>

            <Frame parentKey="Professions" inherits="ForeverTBDTradeskills" parentArray="Views" id="2" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
            </Frame>

            <Frame parentKey="Whispers" inherits="ForeverTBDWhispers" parentArray="Views" id="3" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
            </Frame>

            <Frame parentKey="Journal" inherits="ForeverTBDJournal" parentArray="Views" id="4" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
            </Frame>

            <Frame parentKey="Interactions" inherits="ForeverTBDInteractions" parentArray="Views" id="5" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-60"/>
                    <Anchor point="BOTTOMRIGHT" x="-7" y="5"/>
                </Anchors>
            </Frame>


        </Frames>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Frame>

</Ui>