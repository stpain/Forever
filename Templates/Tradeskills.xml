<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/refs/heads/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">

    <Frame name="ForeverTBDTradeskills" mixin="ForeverTBDTradeskillsMixin" virtual="true">

        <Frames>

            <Button parentKey="DropdownSelectProfession" inherits="ForeverTBDDropdownButtonTemplate">
                <KeyValues>
                    <KeyValue key="defaultText" value="TRADESKILLS" type="global"/>
                </KeyValues>
                <Size x="130" y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="10" y="-9"/>
                </Anchors>
            </Button>

            <EditBox parentKey="RecipeSearchBox" inherits="InputBoxTemplate" autoFocus="false">
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeKey="$parent.DropdownSelectProfession" x="10" y="0"/>
                </Anchors>
                <Size x="145" y="26"/>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Label" text="SEARCH" inherits="GameFontNormal">
                            <Color r="0.5" g="0.5" b="0.5" a="0.8"/>
                            <Anchors>
                                <Anchor point="LEFT" x="5"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </EditBox>

            <!--Middle section character list-->
            <Frame parentKey="CharacterTreeScrollBox" inherits="WowScrollBoxList">
                <Anchors>
                    <Anchor point="TOPLEFT" x="0" y="-35"/>
                    <Anchor point="BOTTOMLEFT" x="0" y="5"/>
                </Anchors>
                <Size x="285"/>
            </Frame>

            <EventFrame parentKey="CharacterTreeScrollBar" inherits="MinimalScrollBar" frameStrata="HIGH">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CharacterTreeScrollBox" relativePoint="TOPRIGHT" x="5" y="-5"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.CharacterTreeScrollBox" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
                </Anchors>
            </EventFrame>

            <!--Right side recipe schematic-->
            <Frame parentKey="SchematicForm" inherits="ForeverTBDRecipeSchematicTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CharacterTreeScrollBox" relativePoint="TOPRIGHT" x="25" y="32"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.CharacterTreeScrollBox" relativePoint="BOTTOMRIGHT" x="25" y="-2"/>
                    <Anchor point="RIGHT" x="-2"/>
                </Anchors>
            </Frame>

        </Frames>

        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>



    <Frame name="ForeverTBDDisenchantingSchematic" mixin="ForeverTBDDisenchantingSchematicMixin" hidden="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture atlas="Profession-background-card-Enchanting">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
			<Layer level="BORDER">
				<Texture atlas="common-insideframe" useAtlasSize="true">
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
                <FontString parentKey="DisenchantingInfo" inherits="GameFontWhite" text="Click an item to disenchant it.">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="25" y="-25"/>
                    </Anchors>
                </FontString>
			</Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
        </Scripts>
    </Frame>

    <Button name="ForeverTBDDE_SecureMacroButton" mixin="ForeverTBDDE_SecureMacroButtonMixin" virtual="true" inherits="SecureActionButtonTemplate">
        <Size x="44" y="44"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="icon">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-2"/>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="border" alpha="0.8">
                    <Anchors>
                        <!-- <Anchor point="TOPLEFT" x="1" y="-1"/>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="1"/> -->
                        <Anchor point="TOPLEFT" x="2" y="-2"/>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

</Ui>